APP_ENV=dev                # dev | prod
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/rumarasa?sslmode=disable
JWT_SECRET=                # required, >= 32 chars: openssl rand -hex 32
CORS_ORIGINS=http://localhost:3000   # comma-separated allowlist
ADMIN_USERNAME=admin       # used once to bootstrap the first admin
ADMIN_PASSWORD=            # min 12 chars
